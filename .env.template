# ── Videro · окружение (скопируй в .env, НЕ коммить) ──────────────────────────

# Обязательно: sk-ключ NeuralDeep Hub (OpenAI-совместимый /v1)
NEURALDEEP_API_KEY=sk-...
ND_BASE_URL=https://api.neuraldeep.ru/v1
NDT_VISION_MODEL=qwen3.6-fp8
# NDT_FIX_MODEL=            # модель для коррекции субтитров (деф = NDT_VISION_MODEL)
# NDT_ASK_MODEL=           # модель для scripts/ask.py (деф = NDT_VISION_MODEL)

# Опционально: субтитры/транскрипт (whisperX с таймкодами + диаризация)
SPEECHCORE_API=https://speechcore.neuraldeep.ru/api
SPEECHCORE_TOKEN=

# Транскод: CPU → libx264; GPU c NVENC → h264_nvenc + PRESET=p4
HLS_VCODEC=libx264
HLS_PRESET=veryfast
HLS_TIME=6

# Анализ
ANALYZE_WORKERS=4          # параллельных запросов к vision-модели
FRAMES_PER_SCENE=3         # кадров на сцену
MAX_SCENE_SEC=30           # макс. длина одной сцены (сек)
